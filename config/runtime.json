{
  "daily_budget_gbp": 2.0,
  "reserve_budget_gbp": 0.2,
  "mode_profiles": {
    "micro": {
      "enabled": true,
      "max_items": 2,
      "max_run_cost": 0.05,
      "validation": "smoke",
      "delegation": false,
      "checkpointing": false
    },
    "deep": {
      "enabled": true,
      "max_items": 5,
      "max_run_cost": 0.2,
      "validation": "smoke",
      "delegation": true,
      "checkpointing": false
    },
    "research_deep": {
      "enabled": false,
      "max_items": 8,
      "max_run_cost": 0.4,
      "validation": "full",
      "delegation": true,
      "checkpointing": true
    }
  },
  "paths": {
    "intent_path": "memory/INTENT.md",
    "reflect_path": "memory/REFLECT.md",
    "philosophy_path": "memory/PHILOSOPHY.md",
    "philosophy_fallback_path": "philosophy/PHILOSOPHY.md",
    "proposals_dir": "memory/proposals",
    "briefings_dir": "memory/briefings",
    "metrics_dir": "memory/metrics",
    "budget_state_path": "data/intention-engine-budget.json",
    "lock_path": "memory/metrics/intention-engine.lock",
    "logs_path": "logs/engine.jsonl",
    "replay_dir": "data/intention-engine-runs",
    "cron_jobs_path": "~/.openclaw/cron/jobs.json"
  },
  "context_sources": [
    {
      "name": "intent",
      "path": "memory/INTENT.md",
      "weight": 1.4
    },
    {
      "name": "philosophy",
      "path": "memory/PHILOSOPHY.md",
      "weight": 1.2
    },
    {
      "name": "knowledge_frameworks",
      "path": "memory/knowledge/frameworks/*.md",
      "weight": 1.0
    },
    {
      "name": "knowledge_patterns",
      "path": "memory/knowledge/patterns/*.md",
      "weight": 1.1
    },
    {
      "name": "knowledge_insights",
      "path": "memory/knowledge/insights/*.md",
      "weight": 0.9
    }
  ],
  "sources": [
    {
      "id": "hn-top-ai",
      "type": "hackernews",
      "name": "Hacker News",
      "enabled": true,
      "limit": 20,
      "timeout_s": 10,
      "filters": {
        "max_age_hours": 120,
        "exclude_keywords": [
          "sports",
          "politics"
        ]
      }
    },
    {
      "id": "reddit-localllama",
      "type": "reddit",
      "subreddit": "LocalLLaMA",
      "name": "LocalLLaMA",
      "enabled": true,
      "limit": 10,
      "timeout_s": 10,
      "filters": {
        "max_age_hours": 168
      }
    },
    {
      "id": "reddit-machinelearning",
      "type": "reddit",
      "subreddit": "MachineLearning",
      "name": "MachineLearning",
      "enabled": true,
      "limit": 10,
      "timeout_s": 10,
      "filters": {
        "max_age_hours": 168,
        "include_keywords": [
          "agent",
          "llm",
          "benchmark",
          "mcp",
          "inference"
        ]
      }
    },
    {
      "id": "github-agentic-ai",
      "type": "github",
      "query": "agentic ai LLM",
      "name": "GitHub Agentic AI",
      "enabled": true,
      "limit": 10,
      "timeout_s": 10,
      "filters": {
        "min_engagement": 5,
        "exclude_keywords": [
          "awesome-list"
        ]
      }
    },
    {
      "id": "rss-aifeed",
      "type": "rss",
      "name": "AIFeed",
      "feed_url": "https://aifeed.dev/feed.xml",
      "enabled": true,
      "limit": 25,
      "timeout_s": 10,
      "filters": {
        "max_age_hours": 168,
        "include_keywords": [
          "agent",
          "model",
          "llm",
          "openai",
          "anthropic",
          "mcp"
        ]
      }
    },
    {
      "id": "arxiv-core-ai",
      "type": "arxiv",
      "name": "arXiv Core AI",
      "categories": [
        "cs.AI",
        "cs.LG",
        "cs.CL",
        "cs.CV"
      ],
      "enabled": true,
      "limit": 20,
      "timeout_s": 12,
      "filters": {
        "max_age_hours": 336,
        "include_keywords": [
          "agent",
          "reasoning",
          "rl",
          "llm",
          "benchmark"
        ]
      }
    }
  ],
  "routing": {
    "auto_safe_threshold": 0.75,
    "policy_guarded_threshold": 0.7,
    "defer_threshold": 0.45,
    "min_relevance_threshold": 0.08,
    "allow_policy_guarded_auto": false,
    "guarded_keywords": [
      "integrate",
      "migration",
      "migrate",
      "replace",
      "security",
      "credential",
      "oauth",
      "auth"
    ],
    "always_human_gate_keywords": [
      "password",
      "secret",
      "token",
      "api key",
      "production",
      "deploy",
      "delete",
      "payment",
      "invoice",
      "email",
      "dm",
      "post",
      "publish"
    ]
  }
}
